generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model categories {
  id                  Int                   @id @default(autoincrement())
  category_name       String                @db.VarChar(100)
  slug                String?               @unique @db.VarChar(100)
  description         String?
  icon                String?               @db.VarChar(100)
  parent_id           Int?
  display_order       Int?                  @default(0)
  status              String?               @default("ACTIVE") @db.VarChar(50)
  parent              categories?           @relation("category_hierarchy", fields: [parent_id], references: [id], onUpdate: NoAction)
  children            categories[]          @relation("category_hierarchy")
  medicine_categories medicine_categories[]
}

model facilities {
  id                       Int                @id @default(autoincrement())
  facility_name            String             @db.VarChar(150)
  facility_type            String             @db.VarChar(50)
  address                  String?
  phone_number             String?            @db.VarChar(20)
  email                    String?            @db.VarChar(100)
  latitude                 Decimal?           @db.Decimal(10, 7)
  longitude                Decimal?           @db.Decimal(10, 7)
  created_at               DateTime?          @default(now()) @db.Timestamptz(6)
  accounts_payable         accounts_payable[]
  batches                  batches[]
  employees                employees[]
  inventories              inventories[]
  inventory_logs           inventory_logs[]
  medicine_boxes           medicine_boxes[]
  orders                   orders[]
  purchase_orders_supplier purchase_orders[]  @relation("po_supplier")
  sscc_cartons             sscc_cartons[]
}

model customers {
  id                  Int                   @id @default(autoincrement())
  membership_tier     String?               @default("BRONZE") @db.VarChar(50)
  reward_points       Int?                  @default(0)
  default_address     String?
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  full_name           String?               @db.VarChar(100)
  phone_number        String?               @unique @db.VarChar(20)
  email               String?               @unique @db.VarChar(100)
  password_hash       String?               @db.VarChar(255)
  status              String?               @default("ACTIVE") @db.VarChar(20)
  accounts_receivable accounts_receivable[]
  cart_items          cart_items[]
  loyalty_point_logs  loyalty_point_logs[]
  orders              orders[]
  prescriptions       prescriptions[]
  qr_scan_logs        qr_scan_logs[]
  reviews             reviews[]
  wishlists           customer_wishlists[]
}

model employees {
  id              Int               @id @default(autoincrement())
  facility_id     Int?
  job_title       String?           @db.VarChar(100)
  joined_date     DateTime?         @default(dbgenerated("CURRENT_DATE")) @db.Date
  full_name       String?           @db.VarChar(100)
  email           String?           @unique @db.VarChar(100)
  password_hash   String?           @db.VarChar(255)
  role            String?           @db.VarChar(50)
  status          String?           @default("ACTIVE") @db.VarChar(20)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  articles        articles[]
  cashbook_logs   cashbook_logs[]
  facilities      facilities?       @relation(fields: [facility_id], references: [id], onUpdate: NoAction)
  inventory_logs  inventory_logs[]
  prescriptions   prescriptions[]
  purchase_orders purchase_orders[]
}

model medicines {
  id                   Int                    @id @default(autoincrement())
  medicine_name        String                 @db.VarChar(255)
  registration_number  String?                @db.VarChar(100)
  active_ingredients   String?
  dosage               String?                @db.VarChar(100)
  manufacturer         String?                @db.VarChar(150)
  country_of_origin    String?                @db.VarChar(100)
  unit_price           Decimal                @default(0) @db.Decimal(15, 2)
  promotional_price    Decimal?               @db.Decimal(15, 2)
  image_url            String?
  short_description    String?
  details              Json?                  @default("{}")
  is_prescription      Boolean?               @default(false)
  status               String?                @default("ACTIVE") @db.VarChar(50)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  effective_price      Decimal?               @default(dbgenerated("COALESCE(NULLIF(promotional_price, (0)::numeric), unit_price)")) @db.Decimal(15, 2)
  slug                 String?                @db.VarChar(255)
  manufacturer_id      Int?
  manufacturer_rel     manufacturers?         @relation(fields: [manufacturer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  batches              batches[]
  inventory_logs       inventory_logs[]
  medicine_categories  medicine_categories[]
  order_items          order_items[]
  packaging_variants   packaging_variants[]
  purchase_order_items purchase_order_items[]
  reviews              reviews[]
  wishlists            customer_wishlists[]

  @@index([effective_price], map: "idx_medicines_effective_price")
  @@index([slug], map: "idx_medicines_slug")
  @@index([manufacturer_id], map: "idx_medicines_manufacturer_id")
}

model packaging_variants {
  id                   Int                    @id @default(autoincrement())
  medicine_id          Int
  unit_name            String                 @db.VarChar(50)
  price                Decimal                @default(0) @db.Decimal(15, 2)
  original_price       Decimal?               @db.Decimal(15, 2)
  discount_percent     Int?                   @default(0)
  is_base_unit         Boolean?               @default(false)
  sale_start_date      DateTime?              @db.Timestamptz(6)
  sale_end_date        DateTime?              @db.Timestamptz(6)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  cart_items           cart_items[]
  inventories          inventories[]
  order_items          order_items[]
  medicine             medicines              @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchase_order_items purchase_order_items[]

  @@index([medicine_id], map: "idx_packaging_variants_medicine")
}

model medicine_categories {
  medicine_id Int
  category_id Int
  is_primary  Boolean    @default(false)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  category    categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicine    medicines  @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([medicine_id, category_id])
  @@index([category_id], map: "idx_medicine_categories_cat_id")
  @@index([medicine_id], map: "idx_medicine_categories_med_id")
}

model medicine_boxes {
  uid                 String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  batch_id            Int?
  carton_id           Int?
  current_facility_id Int?
  status              String?        @default("IN_STOCK") @db.VarChar(50)
  signature           String?
  public_key          String?
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  fraud_alerts        fraud_alerts[]
  medicine_batches    batches?       @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sscc_cartons        sscc_cartons?  @relation(fields: [carton_id], references: [id], onUpdate: NoAction)
  facilities          facilities?    @relation(fields: [current_facility_id], references: [id], onUpdate: NoAction)
  qr_scan_logs        qr_scan_logs[]

  @@index([batch_id], map: "idx_medicine_boxes_batch_id")
  @@index([carton_id], map: "idx_medicine_boxes_carton_id")
  @@index([current_facility_id], map: "idx_medicine_boxes_facility_id")
  @@index([status], map: "idx_medicine_boxes_status")
}

model prescriptions {
  id                        Int        @id @default(autoincrement())
  customer_id               Int?
  prescribing_doctor        String?    @db.VarChar(100)
  medical_facility          String?    @db.VarChar(150)
  diagnosis                 String?
  prescription_image_url    String?
  status                    String?    @default("PENDING_APPROVAL") @db.VarChar(50)
  pharmacist_note           String?
  approved_by_pharmacist_id Int?
  prescribed_date           DateTime?  @db.Date
  created_at                DateTime?  @default(now()) @db.Timestamptz(6)
  orders                    orders[]
  users                     employees? @relation(fields: [approved_by_pharmacist_id], references: [id], onUpdate: NoAction)
  customers                 customers? @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "idx_prescriptions_customer_id")
  @@index([status], map: "idx_prescriptions_status")
}

model vouchers {
  id                  Int       @id @default(autoincrement())
  voucher_code        String    @unique @db.VarChar(50)
  discount_type       String?   @default("PERCENT") @db.VarChar(20)
  discount_value      Decimal   @db.Decimal(15, 2)
  min_order_value     Decimal?  @default(0) @db.Decimal(15, 2)
  max_discount_amount Decimal?  @db.Decimal(15, 2)
  total_quantity      Int?      @default(100)
  used_quantity       Int?      @default(0)
  start_date          DateTime? @db.Timestamptz(6)
  end_date            DateTime? @db.Timestamptz(6)
  status              String?   @default("ACTIVE") @db.VarChar(50)
}

model orders {
  id                  Int                   @id @default(autoincrement())
  order_code          String                @unique @db.VarChar(50)
  customer_id         Int?
  export_facility_id  Int?
  prescription_id     Int?
  subtotal_amount     Decimal               @default(0) @db.Decimal(15, 2)
  shipping_fee        Decimal?              @default(0) @db.Decimal(15, 2)
  discount_amount     Decimal?              @default(0) @db.Decimal(15, 2)
  used_points         Int?                  @default(0)
  total_amount        Decimal               @default(0) @db.Decimal(15, 2)
  payment_method      String?               @default("COD") @db.VarChar(50)
  payment_status      String?               @default("UNPAID") @db.VarChar(50)
  order_status        String?               @default("PENDING") @db.VarChar(50)
  shipping_address    String?
  recipient_phone     String?               @db.VarChar(20)
  recipient_name      String?               @db.VarChar(100)
  note                String?
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  accounts_receivable accounts_receivable[]
  cashbook_logs       cashbook_logs[]
  loyalty_point_logs  loyalty_point_logs[]
  order_items         order_items[]
  customers           customers?            @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  facilities          facilities?           @relation(fields: [export_facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescriptions       prescriptions?        @relation(fields: [prescription_id], references: [id], onUpdate: NoAction)
  shipments           shipments?

  @@index([customer_id], map: "idx_orders_customer_id")
  @@index([order_status], map: "idx_orders_status")
  @@index([created_at], map: "idx_orders_created_at")
}

model order_items {
  id                 Int                 @id @default(autoincrement())
  order_id           Int?
  medicine_id        Int?
  variant_id         Int?
  medicine_name      String?             @db.VarChar(255)
  unit_name          String?             @db.VarChar(50)
  quantity           Int                 @default(1)
  unit_price         Decimal             @default(0) @db.Decimal(15, 2)
  total_price        Decimal             @default(0) @db.Decimal(15, 2)
  assigned_uids      String[]            @default([]) @db.Uuid
  packaging_variants packaging_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction, map: "fk_order_items_variant")
  medicines          medicines?          @relation(fields: [medicine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders             orders?             @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cart_items {
  id                 Int                 @id @default(autoincrement())
  customer_id        Int?
  variant_id         Int?
  quantity           Int                 @default(1)
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  customers          customers?          @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  packaging_variants packaging_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cart_items_variant")

  @@unique([customer_id, variant_id], map: "uq_cart_item")
}

model articles {
  id              Int        @id @default(autoincrement())
  title           String     @db.VarChar(255)
  slug            String     @unique @db.VarChar(255)
  summary         String?
  content         String
  cover_image_url String?
  author_id       Int?
  view_count      Int?       @default(0)
  status          String?    @default("PUBLISHED") @db.VarChar(50)
  created_at      DateTime?  @default(now()) @db.Timestamptz(6)
  users           employees? @relation(fields: [author_id], references: [id], onUpdate: NoAction)
}

model purchase_orders {
  id                     Int                    @id @default(autoincrement())
  po_code                String                 @unique @db.VarChar(50)
  supplier_id            Int
  created_by_employee_id Int?
  total_amount           Decimal?               @default(0) @db.Decimal(15, 2)
  status                 String?                @default("PENDING") @db.VarChar(50)
  note                   String?
  received_at            DateTime?              @default(now()) @db.Timestamptz(6)
  created_at             DateTime?              @default(now()) @db.Timestamptz(6)
  accounts_payable       accounts_payable[]
  cashbook_logs          cashbook_logs[]
  purchase_order_items   purchase_order_items[]
  employees              employees?             @relation(fields: [created_by_employee_id], references: [id], onUpdate: NoAction)
  supplier               facilities             @relation("po_supplier", fields: [supplier_id], references: [id], onUpdate: NoAction)

  @@index([status], map: "idx_po_status")
  @@index([supplier_id], map: "idx_po_supplier")
}

model purchase_order_items {
  id                 Int                 @id @default(autoincrement())
  po_id              Int
  medicine_id        Int
  batch_id           Int?
  variant_id         Int?
  quantity           Int
  unit_price         Decimal             @db.Decimal(12, 2)
  total_price        Decimal?            @default(dbgenerated("((quantity)::numeric * unit_price)")) @db.Decimal(15, 2)
  packaging_variants packaging_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction, map: "fk_po_items_variant")
  medicine_batches   batches?            @relation(fields: [batch_id], references: [id], onUpdate: NoAction)
  medicines          medicines           @relation(fields: [medicine_id], references: [id], onUpdate: NoAction)
  purchase_orders    purchase_orders     @relation(fields: [po_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([medicine_id], map: "idx_po_items_medicine_id")
  @@index([po_id], map: "idx_po_items_po_id")
}

model shipments {
  id                    Int       @id @default(autoincrement())
  order_id              Int       @unique
  tracking_number       String    @unique @db.VarChar(50)
  courier_name          String    @default("EXPRESS_LOGISTICS") @db.VarChar(100)
  shipping_status       String    @default("PENDING_PICKUP") @db.VarChar(50)
  picked_up_at          DateTime? @db.Timestamptz(6)
  estimated_delivery_at DateTime? @db.Timestamptz(6)
  actual_delivery_at    DateTime? @db.Timestamptz(6)
  cod_amount            Decimal   @default(0) @db.Decimal(15, 2)
  cod_settlement_status String    @default("UNSETTLED") @db.VarChar(50)
  cod_settled_at        DateTime? @db.Timestamptz(6)
  note                  String?
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)
  orders                orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cod_settlement_status], map: "idx_shipments_cod_status")
  @@index([order_id], map: "idx_shipments_order_id")
}

model fraud_alerts {
  id                   Int             @id @default(autoincrement())
  uid                  String?         @db.Uuid
  fraud_type           String          @db.VarChar(100)
  severity_level       String?         @default("WARNING") @db.VarChar(50)
  description          String?
  latitude_1           Decimal?        @db.Decimal(10, 7)
  longitude_1          Decimal?        @db.Decimal(10, 7)
  latitude_2           Decimal?        @db.Decimal(10, 7)
  longitude_2          Decimal?        @db.Decimal(10, 7)
  distance_km          Float?
  time_delta_minutes   Float?
  calculated_speed_kmh Float?
  resolution_status    String?         @default("UNRESOLVED") @db.VarChar(50)
  created_at           DateTime?       @default(now()) @db.Timestamptz(6)
  medicine_boxes       medicine_boxes? @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)

  @@index([uid], map: "idx_fraud_alerts_uid")
}

model loyalty_point_logs {
  id               Int       @id @default(autoincrement())
  customer_id      Int
  order_id         Int?
  transaction_type String    @db.VarChar(50)
  points           Int
  description      String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  customers        customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders           orders?   @relation(fields: [order_id], references: [id], onUpdate: NoAction)

  @@index([customer_id], map: "idx_loyalty_logs_customer_id")
  @@index([order_id], map: "idx_loyalty_logs_order_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounts_payable {
  id                Int              @id @default(autoincrement())
  supplier_name     String           @db.VarChar(255)
  supplier_id       Int?
  po_id             Int?
  total_due_amount  Decimal          @db.Decimal(15, 2)
  paid_amount       Decimal?         @default(0) @db.Decimal(15, 2)
  remaining_balance Decimal?         @default(dbgenerated("(total_due_amount - paid_amount)")) @db.Decimal(15, 2)
  due_date          DateTime?        @db.Timestamptz(6)
  status            String?          @default("UNPAID") @db.VarChar(50)
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?        @default(now()) @db.Timestamptz(6)
  purchase_orders   purchase_orders? @relation(fields: [po_id], references: [id], onUpdate: NoAction)
  supplier          facilities?      @relation(fields: [supplier_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounts_receivable {
  id                Int       @id @default(autoincrement())
  customer_id       Int
  order_id          Int?
  total_due_amount  Decimal   @db.Decimal(15, 2)
  paid_amount       Decimal?  @default(0) @db.Decimal(15, 2)
  remaining_balance Decimal?  @default(dbgenerated("(total_due_amount - paid_amount)")) @db.Decimal(15, 2)
  due_date          DateTime? @db.Timestamptz(6)
  status            String?   @default("UNPAID") @db.VarChar(50)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  customers         customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders            orders?   @relation(fields: [order_id], references: [id], onUpdate: NoAction)
}

model batches {
  id                   Int                    @id @default(autoincrement())
  batch_number         String                 @unique @db.VarChar(100)
  medicine_id          Int?
  manufacturer_id      Int?
  production_date      DateTime               @db.Date
  expiry_date          DateTime               @db.Date
  initial_quantity     Int                    @default(0)
  remaining_quantity   Int                    @default(0)
  status               String?                @default("ACTIVE") @db.VarChar(50)
  certificate_co_cq    String?
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  facilities           facilities?            @relation(fields: [manufacturer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicines            medicines?             @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicine_boxes       medicine_boxes[]
  purchase_order_items purchase_order_items[]
  sscc_cartons         sscc_cartons[]

  @@index([medicine_id], map: "idx_batches_medicine_id")
  @@index([expiry_date], map: "idx_batches_expiry_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cashbook_logs {
  id                 Int              @id @default(autoincrement())
  transaction_code   String           @unique @db.VarChar(50)
  transaction_type   String           @db.VarChar(20)
  category           String           @db.VarChar(50)
  amount             Decimal          @db.Decimal(15, 2)
  party_type         String?          @default("OTHER") @db.VarChar(30)
  party_name         String?          @db.VarChar(255)
  order_id           Int?
  po_id              Int?
  payment_method     String?          @default("BANK_TRANSFER") @db.VarChar(50)
  note               String?
  transaction_date   DateTime?        @default(now()) @db.Timestamptz(6)
  created_by_user_id Int?
  orders             orders?          @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  purchase_orders    purchase_orders? @relation(fields: [po_id], references: [id], onUpdate: NoAction)
  users              employees?       @relation(fields: [created_by_user_id], references: [id], onUpdate: NoAction)

  @@index([transaction_date], map: "idx_cashbook_transaction_date")
}

model inventories {
  id                 Int                 @id @default(autoincrement())
  facility_id        Int?
  variant_id         Int?
  stock_quantity     Int                 @default(0)
  reserved_quantity  Int?                @default(0)
  updated_at         DateTime?           @default(now()) @db.Timestamptz(6)
  packaging_variants packaging_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inventories_variant")
  facilities         facilities?         @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([facility_id, variant_id], map: "uq_facility_inventory")
  @@index([variant_id], map: "idx_inventories_variant_id")
}

model inventory_logs {
  id                Int         @id @default(autoincrement())
  facility_id       Int?
  medicine_id       Int?
  transaction_type  String      @db.VarChar(50)
  quantity_changed  Int
  previous_quantity Int
  new_quantity      Int
  reference_code    String?     @db.VarChar(100)
  note              String?
  performed_by_id   Int?
  created_at        DateTime?   @default(now()) @db.Timestamptz(6)
  facilities        facilities? @relation(fields: [facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicines         medicines?  @relation(fields: [medicine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             employees?  @relation(fields: [performed_by_id], references: [id], onUpdate: NoAction)

  @@index([facility_id], map: "idx_inventory_logs_facility_id")
  @@index([medicine_id], map: "idx_inventory_logs_medicine_id")
  @@index([created_at], map: "idx_inventory_logs_created_at")
}

model qr_scan_logs {
  id                 Int            @id @default(autoincrement())
  uid                String         @db.Uuid
  scanned_by_user_id Int?
  latitude           Decimal?       @db.Decimal(10, 7)
  longitude          Decimal?       @db.Decimal(10, 7)
  ip_address         String?        @db.VarChar(50)
  user_agent         String?
  scanned_at         DateTime?      @default(now()) @db.Timestamptz(6)
  scan_result        String?        @default("VALID") @db.VarChar(50)
  risk_score         Int?           @default(0)
  medicine_boxes     medicine_boxes @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  customers          customers?     @relation(fields: [scanned_by_user_id], references: [id], onUpdate: NoAction)

