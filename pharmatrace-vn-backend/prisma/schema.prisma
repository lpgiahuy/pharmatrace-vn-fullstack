generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model packaging_specifications {
  id                   Int                    @id @default(autoincrement())
  unit_name            String                 @db.VarChar(50)
  description          String?
  cart_items           cart_items[]
  inventories          inventories[]
  medicines            medicines[]
  order_items          order_items[]
  purchase_order_items purchase_order_items[]
}

model categories {
  id            Int         @id @default(autoincrement())
  category_name String      @db.VarChar(100)
  description   String?
  icon          String?     @db.VarChar(100)
  medicines     medicines[]
}

model facilities {
  id                       Int               @id @default(autoincrement())
  facility_name            String            @db.VarChar(150)
  facility_type            String            @db.VarChar(50)
  address                  String?
  phone_number             String?           @db.VarChar(20)
  email                    String?           @db.VarChar(100)
  latitude                 Decimal?          @db.Decimal(10, 7)
  longitude                Decimal?          @db.Decimal(10, 7)
  created_at               DateTime?         @default(now()) @db.Timestamp(6)
  batches                  batches[]
  employees                employees[]
  inventories              inventories[]
  inventory_logs           inventory_logs[]
  medicine_boxes           medicine_boxes[]
  orders                   orders[]
  purchase_orders_supplier purchase_orders[] @relation("po_supplier")
  sscc_cartons             sscc_cartons[]
}

model customers {
  id                  Int                   @id @default(autoincrement())
  membership_tier     String?               @default("BRONZE") @db.VarChar(50)
  reward_points       Int?                  @default(0)
  default_address     String?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  full_name           String?               @db.VarChar(100)
  phone_number        String?               @db.VarChar(20)
  email               String?               @db.VarChar(100)
  password_hash       String?               @db.VarChar(255)
  status              String?               @default("ACTIVE") @db.VarChar(20)
  accounts_receivable accounts_receivable[]
  cart_items          cart_items[]
  loyalty_point_logs  loyalty_point_logs[]
  orders              orders[]
  prescriptions       prescriptions[]
  reviews             reviews[]
}

model employees {
  id              Int               @id @default(autoincrement())
  facility_id     Int?
  job_title       String?           @db.VarChar(100)
  joined_date     DateTime?         @default(dbgenerated("CURRENT_DATE")) @db.Date
  full_name       String?           @db.VarChar(100)
  email           String?           @db.VarChar(100)
  password_hash   String?           @db.VarChar(255)
  role            String?           @db.VarChar(50)
  status          String?           @default("ACTIVE") @db.VarChar(20)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  articles        articles[]
  facilities      facilities?       @relation(fields: [facility_id], references: [id], onUpdate: NoAction)
  inventory_logs  inventory_logs[]
  prescriptions   prescriptions[]
  purchase_orders purchase_orders[]
}

model medicines {
  id                       Int                       @id @default(autoincrement())
  medicine_name            String                    @db.VarChar(255)
  category_id              Int?
  packaging_id             Int?
  registration_number      String?                   @db.VarChar(100)
  active_ingredients       String?
  dosage                   String?                   @db.VarChar(100)
  manufacturer             String?                   @db.VarChar(150)
  country_of_origin        String?                   @db.VarChar(100)
  unit_price               Decimal                   @default(0) @db.Decimal(15, 2)
  promotional_price        Decimal?                  @db.Decimal(15, 2)
  image_url                String?
  short_description        String?
  details                  Json?                     @default("{}")
  is_prescription          Boolean?                  @default(false)
  status                   String?                   @default("ACTIVE") @db.VarChar(50)
  created_at               DateTime?                 @default(now()) @db.Timestamp(6)
  batches                  batches[]
  cart_items               cart_items[]
  inventories              inventories[]
  inventory_logs           inventory_logs[]
  categories               categories?               @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  packaging_specifications packaging_specifications? @relation(fields: [packaging_id], references: [id], onUpdate: NoAction)
  order_items              order_items[]
  purchase_order_items     purchase_order_items[]
  reviews                  reviews[]
}

model medicine_boxes {
  uid                 String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  batch_id            Int?
  carton_id           Int?
  current_facility_id Int?
  status              String?        @default("IN_STOCK") @db.VarChar(50)
  signature           String?
  public_key          String?
  created_at          DateTime?      @default(now()) @db.Timestamp(6)
  fraud_alerts        fraud_alerts[]
  medicine_batches    batches?       @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sscc_cartons        sscc_cartons?  @relation(fields: [carton_id], references: [id], onUpdate: NoAction)
  facilities          facilities?    @relation(fields: [current_facility_id], references: [id], onUpdate: NoAction)
  qr_scan_logs        qr_scan_logs[]
}

model prescriptions {
  id                        Int        @id @default(autoincrement())
  customer_id               Int?
  prescribing_doctor        String?    @db.VarChar(100)
  medical_facility          String?    @db.VarChar(150)
  diagnosis                 String?
  prescription_image_url    String?
  status                    String?    @default("PENDING_APPROVAL") @db.VarChar(50)
  pharmacist_note           String?
  approved_by_pharmacist_id Int?
  prescribed_date           DateTime?  @db.Date
  created_at                DateTime?  @default(now()) @db.Timestamp(6)
  orders                    orders[]
  users                     employees? @relation(fields: [approved_by_pharmacist_id], references: [id], onUpdate: NoAction)
  customers                 customers? @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model vouchers {
  id                  Int       @id @default(autoincrement())
  voucher_code        String    @unique @db.VarChar(50)
  discount_type       String?   @default("PERCENT") @db.VarChar(20)
  discount_value      Decimal   @db.Decimal(15, 2)
  min_order_value     Decimal?  @default(0) @db.Decimal(15, 2)
  max_discount_amount Decimal?  @db.Decimal(15, 2)
  total_quantity      Int?      @default(100)
  used_quantity       Int?      @default(0)
  start_date          DateTime? @db.Timestamp(6)
  end_date            DateTime? @db.Timestamp(6)
  status              String?   @default("ACTIVE") @db.VarChar(50)
}

model orders {
  id                  Int                   @id @default(autoincrement())
  order_code          String                @unique @db.VarChar(50)
  customer_id         Int?
  export_facility_id  Int?
  prescription_id     Int?
  subtotal_amount     Decimal               @default(0) @db.Decimal(15, 2)
  shipping_fee        Decimal?              @default(0) @db.Decimal(15, 2)
  discount_amount     Decimal?              @default(0) @db.Decimal(15, 2)
  used_points         Int?                  @default(0)
  total_amount        Decimal               @default(0) @db.Decimal(15, 2)
  payment_method      String?               @default("COD") @db.VarChar(50)
  payment_status      String?               @default("UNPAID") @db.VarChar(50)
  order_status        String?               @default("PENDING") @db.VarChar(50)
  shipping_address    String?
  recipient_phone     String?               @db.VarChar(20)
  recipient_name      String?               @db.VarChar(100)
  note                String?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  accounts_receivable accounts_receivable[]
  cashbook_logs       cashbook_logs[]
  loyalty_point_logs  loyalty_point_logs[]
  order_items         order_items[]
  customers           customers?            @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  facilities          facilities?           @relation(fields: [export_facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescriptions       prescriptions?        @relation(fields: [prescription_id], references: [id], onUpdate: NoAction)
  shipments           shipments?
}

model order_items {
  id                       Int                       @id @default(autoincrement())
  order_id                 Int?
  medicine_id              Int?
  packaging_id             Int?
  quantity                 Int                       @default(1)
  unit_price               Decimal                   @default(0) @db.Decimal(15, 2)
  total_price              Decimal                   @default(0) @db.Decimal(15, 2)
  assigned_uids            String[]                  @default([]) @db.Uuid
  medicines                medicines?                @relation(fields: [medicine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                   orders?                   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  packaging_specifications packaging_specifications? @relation(fields: [packaging_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model cart_items {
  id                       Int                       @id @default(autoincrement())
  customer_id              Int?
  medicine_id              Int?
  packaging_id             Int?
  quantity                 Int                       @default(1)
  created_at               DateTime?                 @default(now()) @db.Timestamp(6)
  customers                customers?                @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicines                medicines?                @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  packaging_specifications packaging_specifications? @relation(fields: [packaging_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([customer_id, medicine_id, packaging_id], map: "uq_cart_item")
}

model articles {
  id              Int        @id @default(autoincrement())
  title           String     @db.VarChar(255)
  qtyug           String     @unique @db.VarChar(255)
  summary         String?
  content         String
  cover_image_url String?
  author_id       Int?
  view_count      Int?       @default(0)
  status          String?    @default("PUBLISHED") @db.VarChar(50)
  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  users           employees? @relation(fields: [author_id], references: [id], onUpdate: NoAction)
}

model purchase_orders {
  id                     Int                    @id @default(autoincrement())
  po_code                String                 @unique @db.VarChar(50)
  supplier_id            Int
  created_by_employee_id Int?
  total_amount           Decimal?               @default(0) @db.Decimal(15, 2)
  status                 String?                @default("PENDING") @db.VarChar(50)
  note                   String?
  received_at            DateTime?              @default(now()) @db.Timestamptz(6)
  created_at             DateTime?              @default(now()) @db.Timestamptz(6)
  accounts_payable       accounts_payable[]
  cashbook_logs          cashbook_logs[]
  purchase_order_items   purchase_order_items[]
  employees              employees?             @relation(fields: [created_by_employee_id], references: [id], onUpdate: NoAction)
  supplier               facilities             @relation("po_supplier", fields: [supplier_id], references: [id], onUpdate: NoAction)

  @@index([status], map: "idx_po_status")
  @@index([supplier_id], map: "idx_po_supplier")
}

model purchase_order_items {
  id                       Int                       @id @default(autoincrement())
  po_id                    Int
  medicine_id              Int
  batch_id                 Int?
  packaging_id             Int?
  quantity                 Int
  unit_price               Decimal                   @db.Decimal(12, 2)
  total_price              Decimal?                  @default(dbgenerated("((quantity)::numeric * unit_price)")) @db.Decimal(15, 2)
  medicine_batches         batches?                  @relation(fields: [batch_id], references: [id], onUpdate: NoAction)
  medicines                medicines                 @relation(fields: [medicine_id], references: [id], onUpdate: NoAction)
  packaging_specifications packaging_specifications? @relation(fields: [packaging_id], references: [id], onUpdate: NoAction)
  purchase_orders          purchase_orders           @relation(fields: [po_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([medicine_id], map: "idx_po_items_medicine_id")
  @@index([po_id], map: "idx_po_items_po_id")
}

model shipments {
  id                    Int       @id @default(autoincrement())
  order_id              Int       @unique
  tracking_number       String    @unique @db.VarChar(50)
  courier_name          String    @default("EXPRESS_LOGISTICS") @db.VarChar(100)
  shipping_status       String    @default("PENDING_PICKUP") @db.VarChar(50)
  picked_up_at          DateTime? @db.Timestamp(6)
  estimated_delivery_at DateTime? @db.Timestamp(6)
  actual_delivery_at    DateTime? @db.Timestamp(6)
  cod_amount            Decimal   @default(0) @db.Decimal(15, 2)
  cod_settlement_status String    @default("UNSETTLED") @db.VarChar(50)
  cod_settled_at        DateTime? @db.Timestamp(6)
  note                  String?
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  orders                orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cod_settlement_status], map: "idx_shipments_cod_status")
  @@index([order_id], map: "idx_shipments_order_id")
}

model fraud_alerts {
  id                   Int             @id @default(autoincrement())
  uid                  String?         @db.Uuid
  fraud_type           String          @db.VarChar(100)
  severity_level       String?         @default("WARNING") @db.VarChar(50)
  description          String?
  latitude_1           Decimal?        @db.Decimal(10, 7)
  longitude_1          Decimal?        @db.Decimal(10, 7)
  latitude_2           Decimal?        @db.Decimal(10, 7)
  longitude_2          Decimal?        @db.Decimal(10, 7)
  distance_km          Float?
  time_delta_minutes   Float?
  calculated_speed_kmh Float?
  resolution_status    String?         @default("UNRESOLVED") @db.VarChar(50)
  created_at           DateTime?       @default(now()) @db.Timestamp(6)
  medicine_boxes       medicine_boxes? @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)

  @@index([uid], map: "idx_fraud_alerts_uid")
}

model loyalty_point_logs {
  id               Int       @id @default(autoincrement())
  customer_id      Int
  order_id         Int?
  transaction_type String    @db.VarChar(50)
  points           Int
  description      String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  customers        customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders           orders?   @relation(fields: [order_id], references: [id], onUpdate: NoAction)

  @@index([customer_id], map: "idx_loyalty_logs_customer_id")
  @@index([order_id], map: "idx_loyalty_logs_order_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounts_payable {
  id                Int              @id @default(autoincrement())
  supplier_name     String           @db.VarChar(255)
  po_id             Int?
  total_due_amount  Decimal          @db.Decimal(15, 2)
  paid_amount       Decimal?         @default(0) @db.Decimal(15, 2)
  remaining_balance Decimal?         @default(dbgenerated("(total_due_amount - paid_amount)")) @db.Decimal(15, 2)
  due_date          DateTime?        @db.Timestamptz(6)
  status            String?          @default("UNPAID") @db.VarChar(50)
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?        @default(now()) @db.Timestamptz(6)
  purchase_orders   purchase_orders? @relation(fields: [po_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounts_receivable {
  id                Int       @id @default(autoincrement())
  customer_id       Int
  order_id          Int?
  total_due_amount  Decimal   @db.Decimal(15, 2)
  paid_amount       Decimal?  @default(0) @db.Decimal(15, 2)
  remaining_balance Decimal?  @default(dbgenerated("(total_due_amount - paid_amount)")) @db.Decimal(15, 2)
  due_date          DateTime? @db.Timestamptz(6)
  status            String?   @default("UNPAID") @db.VarChar(50)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  customers         customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders            orders?   @relation(fields: [order_id], references: [id], onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model baiviet {
  id                Int       @id @default(autoincrement())
  tieu_de           String    @db.VarChar(255)
  anh_bia           String?
  noi_dung          String
  ngay_dang         DateTime? @default(now()) @db.Timestamp(6)
  nhan_vien_dang_id Int?
  nhanvien          nhanvien? @relation(fields: [nhan_vien_dang_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model batches {
  id                   Int                    @id @default(autoincrement())
  batch_number         String                 @unique @db.VarChar(100)
  medicine_id          Int?
  manufacturer_id      Int?
  production_date      DateTime               @db.Date
  expiry_date          DateTime               @db.Date
  initial_quantity     Int                    @default(0)
  remaining_quantity   Int                    @default(0)
  status               String?                @default("ACTIVE") @db.VarChar(50)
  certificate_co_cq    String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  facilities           facilities?            @relation(fields: [manufacturer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicines            medicines?             @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicine_boxes       medicine_boxes[]
  purchase_order_items purchase_order_items[]
  sscc_cartons         sscc_cartons[]
}

model canhbao_gianlan {
  id                               Int        @id @default(autoincrement())
  uid                              String?    @db.Uuid
  loai_gian_lan                    String     @db.VarChar(100)
  muc_do_nghiem_trong              String?    @default("CANH_BAO") @db.VarChar(50)
  mo_ta                            String?
  latitude_1                       Decimal?   @db.Decimal(10, 7)
  longitude_1                      Decimal?   @db.Decimal(10, 7)
  latitude_2                       Decimal?   @db.Decimal(10, 7)
  longitude_2                      Decimal?   @db.Decimal(10, 7)
  khoang_cach_km                   Float?
  thoi_gian_giua_hai_lan_quet_phut Float?
  van_toc_kmh                      Float?
  trang_thai_xu_ly                 String?    @default("CHUA_XU_LY") @db.VarChar(50)
  ngay_tao                         DateTime?  @default(now()) @db.Timestamp(6)
  nhatky_id                        Int?
  hop_thuoc_uid                    String?    @db.Uuid
  loai_canh_bao                    String?    @db.VarChar(100)
  muc_do_rui_ro                    String?    @default("Warning") @db.VarChar(50)
  toa_do_lat_truoc                 Decimal?   @db.Decimal(10, 7)
  toa_do_lng_truoc                 Decimal?   @db.Decimal(10, 7)
  toa_do_lat_sau                   Decimal?   @db.Decimal(10, 7)
  toa_do_lng_sau                   Decimal?   @db.Decimal(10, 7)
  thoi_gian_chenh_phut             Float?
  trang_thai                       String?    @default("Moi") @db.VarChar(50)
  mahop_uid                        mahop_uid? @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)

  @@index([uid], map: "idx_canhbao_gianlan_uid")
}

