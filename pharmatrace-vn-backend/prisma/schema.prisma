generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model packaging_specifications {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique @db.VarChar(50)
  description          String?
  cart_items           cart_items[]
  facility_inventories facility_inventories[]
  medicines            medicines[]
  order_items          order_items[]
  purchase_order_items purchase_order_items[]
}

model categories {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  description String?
  icon        String?     @db.VarChar(100)
  medicines   medicines[]
}

model facilities {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(150)
  type                 String                 @db.VarChar(50)
  address              String?
  phone                String?                @db.VarChar(20)
  email                String?                @db.VarChar(100)
  latitude             Decimal?               @db.Decimal(10, 7)
  longitude            Decimal?               @db.Decimal(10, 7)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  employees            employees[]
  facility_inventories facility_inventories[]
  inventory_transactions inventory_transactions[]
  medicine_batches     medicine_batches[]
  medicine_boxes       medicine_boxes[]
  orders               orders[]
  purchase_orders_supplier    purchase_orders[] @relation("po_supplier")
  purchase_orders_destination purchase_orders[] @relation("po_destination")
  shipping_packages    shipping_packages[]
  users                users[]
}

model users {
  id                     Int                      @id @default(autoincrement())
  username               String                   @unique @db.VarChar(50)
  password               String                   @db.VarChar(255)
  full_name              String                   @db.VarChar(100)
  email                  String?                  @unique @db.VarChar(100)
  phone                  String?                  @db.VarChar(20)
  role                   String                   @default("CUSTOMER") @db.VarChar(50)
  status                 String?                  @default("ACTIVE") @db.VarChar(50)
  facility_id            Int?
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  articles               articles[]
  cash_flow_transactions cash_flow_transactions[]
  customers              customers?
  employees              employees?
  inventory_transactions inventory_transactions[]
  prescriptions          prescriptions[]
  purchase_orders        purchase_orders[]
  facilities             facilities?              @relation(fields: [facility_id], references: [id], onUpdate: NoAction)
  verification_logs      verification_logs[]
}

model customers {
  id                 Int                  @id @default(autoincrement())
  user_id            Int?                 @unique
  membership_tier    String?              @default("BRONZE") @db.VarChar(50)
  reward_points      Int?                 @default(0)
  default_address    String?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  cart_items         cart_items[]
  customer_debts     customer_debts[]
  users              users?               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  loyalty_point_logs loyalty_point_logs[]
  orders             orders[]
  prescriptions      prescriptions[]
  product_reviews    product_reviews[]
  return_orders      return_orders[]
}

model employees {
  id          Int         @id @default(autoincrement())
  user_id     Int?        @unique
  facility_id Int?
  job_title   String?     @db.VarChar(100)
  hire_date   DateTime?   @default(now()) @db.Date
  facilities  facilities? @relation(fields: [facility_id], references: [id], onUpdate: NoAction)
  users       users?      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model medicines {
  id                       Int                       @id @default(autoincrement())
  name                     String                    @db.VarChar(255)
  category_id              Int?
  packaging_id             Int?
  registration_number      String?                   @db.VarChar(100)
  active_ingredients       String?
  dosage                   String?                   @db.VarChar(100)
  manufacturer             String?                   @db.VarChar(150)
  country_of_origin        String?                   @db.VarChar(100)
  unit_price               Decimal                   @default(0) @db.Decimal(15, 2)
  sale_price               Decimal?                  @db.Decimal(15, 2)
  image_url                String?
  description              String?
  drug_details             Json?                     @default("{}")
  is_prescription_required Boolean?                  @default(false)
  status                   String?                   @default("ACTIVE") @db.VarChar(50)
  created_at               DateTime?                 @default(now()) @db.Timestamp(6)
  cart_items               cart_items[]
  facility_inventories     facility_inventories[]
  inventory_transactions   inventory_transactions[]
  medicine_batches         medicine_batches[]
  categories               categories?               @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  packaging_specifications packaging_specifications? @relation(fields: [packaging_id], references: [id], onUpdate: NoAction)
  order_items              order_items[]
  product_reviews          product_reviews[]
  purchase_order_items     purchase_order_items[]
  return_order_items       return_order_items[]
}

model medicine_batches {
  id                   Int                    @id @default(autoincrement())
  batch_number         String                 @unique @db.VarChar(100)
  medicine_id          Int?
  manufacturer_id      Int?
  manufacturing_date   DateTime               @db.Date
  expiry_date          DateTime               @db.Date
  initial_quantity     Int                    @default(0)
  current_quantity     Int                    @default(0)
  status               String?                @default("NORMAL") @db.VarChar(50)
  co_cq_certificate    String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  facilities           facilities?            @relation(fields: [manufacturer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicines            medicines?             @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicine_boxes       medicine_boxes[]
  purchase_order_items purchase_order_items[]
  shipping_packages    shipping_packages[]
}

model shipping_packages {
  id                  Int               @id @default(autoincrement())
  sscc_code           String            @unique @db.VarChar(50)
  batch_id            Int?
  current_facility_id Int?
  status              String?           @default("PACKED") @db.VarChar(50)
  box_count           Int?              @default(0)
  created_at          DateTime?         @default(now()) @db.Timestamp(6)
  medicine_boxes      medicine_boxes[]
  medicine_batches    medicine_batches? @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  facilities          facilities?       @relation(fields: [current_facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model medicine_boxes {
  uid                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  batch_id            Int?
  shipping_package_id Int?
  current_facility_id Int?
  secret_code_hash    String?            @db.VarChar(255)
  status              String?            @default("IN_STOCK") @db.VarChar(50)
  signature           String?
  public_key          String?
  activated_at        DateTime?          @db.Timestamp(6)
  created_at          DateTime?          @default(now()) @db.Timestamp(6)
  fraud_alerts        fraud_alerts[]
  medicine_batches    medicine_batches?  @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  facilities          facilities?        @relation(fields: [current_facility_id], references: [id], onUpdate: NoAction)
  shipping_packages   shipping_packages? @relation(fields: [shipping_package_id], references: [id], onUpdate: NoAction)
  verification_logs   verification_logs[]
}

model facility_inventories {
  id                       Int                       @id @default(autoincrement())
  facility_id              Int?
  medicine_id              Int?
  packaging_id             Int?
  stock_quantity           Int                       @default(0)
  reserved_quantity        Int?                      @default(0)
  updated_at               DateTime?                 @default(now()) @db.Timestamp(6)
  facilities               facilities?               @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicines                medicines?                @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  packaging_specifications packaging_specifications? @relation(fields: [packaging_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([facility_id, medicine_id, packaging_id], map: "uq_facility_inventory")
}

model inventory_transactions {
  id                 Int         @id @default(autoincrement())
  facility_id        Int?
  medicine_id        Int?
  transaction_type   String      @db.VarChar(50)
  change_quantity    Int
  previous_quantity  Int
  remaining_quantity Int
  reference_code     String?     @db.VarChar(100)
  note               String?
  performed_by_id    Int?
  created_at         DateTime?   @default(now()) @db.Timestamp(6)
  facilities         facilities? @relation(fields: [facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicines          medicines?  @relation(fields: [medicine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              users?      @relation(fields: [performed_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model prescriptions {
  id                      Int        @id @default(autoincrement())
  customer_id             Int?
  doctor_name             String?    @db.VarChar(100)
  hospital_clinic         String?    @db.VarChar(150)
  diagnosis               String?
  prescription_image_url  String?
  status                  String?    @default("PENDING") @db.VarChar(50)
  pharmacist_note         String?
  approved_by_pharmacist_id Int?
  issued_date             DateTime?  @db.Date
  created_at              DateTime?  @default(now()) @db.Timestamp(6)
  orders                  orders[]
  users                   users?     @relation(fields: [approved_by_pharmacist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers               customers? @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model vouchers {
  id                 Int       @id @default(autoincrement())
  code               String    @unique @db.VarChar(50)
  discount_type      String?   @default("PERCENT") @db.VarChar(20)
  discount_value     Decimal   @db.Decimal(15, 2)
  min_order_value    Decimal?  @default(0) @db.Decimal(15, 2)
  max_discount_amount Decimal? @db.Decimal(15, 2)
  total_quantity     Int?      @default(100)
  used_quantity      Int?      @default(0)
  start_date         DateTime? @db.Timestamp(6)
  end_date           DateTime? @db.Timestamp(6)
  status             String?   @default("ACTIVE") @db.VarChar(50)
}

model orders {
  id                     Int                      @id @default(autoincrement())
  order_code             String                   @unique @db.VarChar(50)
  customer_id            Int?
  source_facility_id     Int?
  prescription_id        Int?
  subtotal_amount        Decimal                  @default(0) @db.Decimal(15, 2)
  shipping_fee           Decimal?                 @default(0) @db.Decimal(15, 2)
  discount_amount        Decimal?                 @default(0) @db.Decimal(15, 2)
  reward_points_used     Int?                     @default(0)
  total_amount           Decimal                  @default(0) @db.Decimal(15, 2)
  payment_method         String?                  @default("COD") @db.VarChar(50)
  payment_status         String?                  @default("UNPAID") @db.VarChar(50)
  order_status           String?                  @default("PENDING") @db.VarChar(50)
  shipping_address       String?
  recipient_phone        String?                  @db.VarChar(20)
  recipient_name         String?                  @db.VarChar(100)
  bank_transaction_code  String?                  @unique @db.VarChar(100)
  note                   String?
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  cash_flow_transactions cash_flow_transactions[]
  customer_debts         customer_debts[]
  loyalty_point_logs     loyalty_point_logs[]
  order_items            order_items[]
  customers              customers?               @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  prescriptions          prescriptions?           @relation(fields: [prescription_id], references: [id], onUpdate: NoAction)
  facilities             facilities?              @relation(fields: [source_facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  return_orders          return_orders[]
  shipments              shipments?
}

model order_items {
  id                       Int                       @id @default(autoincrement())
  order_id                 Int?
  medicine_id              Int?
  packaging_id             Int?
  quantity                 Int                       @default(1)
  unit_price               Decimal                   @default(0) @db.Decimal(15, 2)
  total_price              Decimal                   @default(0) @db.Decimal(15, 2)
  box_uids                 String[]                  @default([]) @db.Uuid
  medicines                medicines?                @relation(fields: [medicine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                   orders?                   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  packaging_specifications packaging_specifications? @relation(fields: [packaging_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model cart_items {
  id                       Int                       @id @default(autoincrement())
  customer_id              Int?
  medicine_id              Int?
  packaging_id             Int?
  quantity                 Int                       @default(1)
  created_at               DateTime?                 @default(now()) @db.Timestamp(6)
  customers                customers?                @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicines                medicines?                @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  packaging_specifications packaging_specifications? @relation(fields: [packaging_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([customer_id, medicine_id, packaging_id], map: "uq_cart_item")
}

model product_reviews {
  id          Int        @id @default(autoincrement())
  customer_id Int?
  medicine_id Int?
  rating      Int?
  content     String?
  images      String[]
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  customers   customers? @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicines   medicines? @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model articles {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  summary         String?
  content         String
  cover_image_url String?
  author_id       Int?
  view_count      Int?      @default(0)
  status          String?   @default("PUBLISHED") @db.VarChar(50)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users?    @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model purchase_orders {
  id                     Int                    @id @default(autoincrement())
  po_code                String                 @unique @db.VarChar(50)
  supplier_id            Int
  destination_facility_id Int?
  created_by_id          Int?
  total_amount           Decimal?               @default(0) @db.Decimal(15, 2)
  status                 String?                @default("PENDING") @db.VarChar(50)
  note                   String?
  po_date                DateTime?              @default(now()) @db.Timestamp(6)
  created_at             DateTime?              @default(now()) @db.Timestamp(6)
  cash_flow_transactions cash_flow_transactions[]
  purchase_order_items   purchase_order_items[]
  users                  users?                 @relation(fields: [created_by_id], references: [id], onUpdate: NoAction)
  destination_facility   facilities?            @relation("po_destination", fields: [destination_facility_id], references: [id], onUpdate: NoAction)
  supplier               facilities             @relation("po_supplier", fields: [supplier_id], references: [id], onUpdate: NoAction)
  supplier_debts         supplier_debts[]

  @@index([status], map: "idx_po_status")
  @@index([supplier_id], map: "idx_po_supplier")
}

model purchase_order_items {
  id                       Int                       @id @default(autoincrement())
  purchase_order_id        Int
  medicine_id              Int
  batch_id                 Int?
  packaging_id             Int?
  ordered_quantity         Int
  received_quantity        Int?                      @default(0)
  unit_price               Decimal                   @db.Decimal(12, 2)
  total_price              Decimal                   @db.Decimal(15, 2)
  medicine_batches         medicine_batches?         @relation(fields: [batch_id], references: [id], onUpdate: NoAction)
  medicines                medicines                 @relation(fields: [medicine_id], references: [id], onUpdate: NoAction)
  packaging_specifications packaging_specifications? @relation(fields: [packaging_id], references: [id], onUpdate: NoAction)
  purchase_orders          purchase_orders           @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([medicine_id], map: "idx_po_items_medicine")
  @@index([purchase_order_id], map: "idx_po_items_po")
}

model shipments {
  id                      Int       @id @default(autoincrement())
  order_id                Int       @unique
  tracking_number         String    @unique @db.VarChar(50)
  courier_name            String    @default("GiaoHangNhanh") @db.VarChar(100)
  shipment_status         String    @default("PENDING_PICKUP") @db.VarChar(50)
  pickup_date             DateTime? @db.Timestamp(6)
  estimated_delivery_date DateTime? @db.Timestamp(6)
  actual_delivery_date    DateTime? @db.Timestamp(6)
  cod_amount              Decimal   @default(0) @db.Decimal(15, 2)
  cod_status              String    @default("UNRECONCILED") @db.VarChar(50)
  cod_reconciled_at       DateTime? @db.Timestamp(6)
  note                    String?
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
  orders                  orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cod_status], map: "idx_shipments_cod_status")
  @@index([order_id], map: "idx_shipments_order")
}

model verification_logs {
  id                  Int             @id @default(autoincrement())
  uid                 String          @db.Uuid
  user_id             Int?
  latitude            Decimal?        @db.Decimal(10, 7)
  longitude           Decimal?        @db.Decimal(10, 7)
  ip_address          String?         @db.VarChar(50)
  user_agent          String?
  scan_timestamp      DateTime?       @default(now()) @db.Timestamp(6)
  verification_result String?         @default("AUTHENTIC_FIRST_TIME") @db.VarChar(50)
  risk_score          Int?            @default(0)
  medicine_boxes      medicine_boxes  @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  users               users?          @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([uid], map: "idx_verification_logs_uid")
}

model fraud_alerts {
  id                 Int             @id @default(autoincrement())
  uid                String?         @db.Uuid
  alert_type         String          @db.VarChar(100)
  severity           String?         @default("MEDIUM") @db.VarChar(50)
  description        String?
  latitude_1         Decimal?        @db.Decimal(10, 7)
  longitude_1        Decimal?        @db.Decimal(10, 7)
  latitude_2         Decimal?        @db.Decimal(10, 7)
  longitude_2        Decimal?        @db.Decimal(10, 7)
  distance_km        Float?
  time_diff_minutes  Float?
  velocity_kmh       Float?
  resolution_status  String?         @default("OPEN") @db.VarChar(50)
  created_at         DateTime?       @default(now()) @db.Timestamp(6)
  medicine_boxes     medicine_boxes? @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)

  @@index([uid], map: "idx_fraud_alerts_uid")
}

model loyalty_point_logs {
  id               Int        @id @default(autoincrement())
  customer_id      Int
  order_id         Int?
  transaction_type String     @db.VarChar(50)
  points           Int
  description      String?
  created_at       DateTime?  @default(now()) @db.Timestamp(6)
  customers        customers  @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders           orders?    @relation(fields: [order_id], references: [id], onUpdate: NoAction)

  @@index([customer_id], map: "idx_point_logs_customer")
}

model return_orders {
  id                 Int                  @id @default(autoincrement())
  rma_code           String               @unique @db.VarChar(50)
  order_id           Int
  customer_id        Int
  reason             String
  return_status      String?              @default("PENDING") @db.VarChar(50)
  refund_amount      Decimal?             @default(0) @db.Decimal(15, 2)
  note               String?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  return_order_items return_order_items[]
  customers          customers            @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders             orders               @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_return_orders_order")
}

model return_order_items {
  id              Int           @id @default(autoincrement())
  return_order_id Int
  medicine_id     Int
  quantity        Int
  reason          String?
  medicines       medicines     @relation(fields: [medicine_id], references: [id], onUpdate: NoAction)
  return_orders   return_orders @relation(fields: [return_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cash_flow_transactions {
  id                Int              @id @default(autoincrement())
  transaction_code  String           @unique @db.VarChar(50)
  transaction_type  String           @db.VarChar(20)
  category          String           @db.VarChar(50)
  amount            Decimal          @db.Decimal(15, 2)
  counterparty_type String?          @default("OTHER") @db.VarChar(30)
  counterparty_name String?          @db.VarChar(255)
  order_id          Int?
  purchase_order_id Int?
  payment_method    String?          @default("BANK_TRANSFER") @db.VarChar(50)
  note              String?
  transaction_date  DateTime?        @default(now()) @db.Timestamp(6)
  created_by_id     Int?
  users             users?           @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders            orders?          @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  purchase_orders   purchase_orders? @relation(fields: [purchase_order_id], references: [id], onUpdate: NoAction)
}

model customer_debts {
  id                    Int       @id @default(autoincrement())
  customer_id           Int
  order_id              Int?
  total_debt_amount     Decimal   @db.Decimal(15, 2)
  paid_amount           Decimal?  @default(0) @db.Decimal(15, 2)
  remaining_debt_amount Decimal   @db.Decimal(15, 2)
  due_date              DateTime? @db.Timestamp(6)
  debt_status           String?   @default("UNPAID") @db.VarChar(50)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  customers             customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders                orders?   @relation(fields: [order_id], references: [id], onUpdate: NoAction)
}

model supplier_debts {
  id                    Int              @id @default(autoincrement())
  supplier_name         String           @db.VarChar(255)
  purchase_order_id     Int?
  total_debt_amount     Decimal          @db.Decimal(15, 2)
  paid_amount           Decimal?         @default(0) @db.Decimal(15, 2)
  remaining_debt_amount Decimal          @db.Decimal(15, 2)
  due_date              DateTime?        @db.Timestamp(6)
  debt_status           String?          @default("UNPAID") @db.VarChar(50)
  created_at            DateTime?        @default(now()) @db.Timestamp(6)
  updated_at            DateTime?        @default(now()) @db.Timestamp(6)
  purchase_orders       purchase_orders? @relation(fields: [purchase_order_id], references: [id], onUpdate: NoAction)
}
